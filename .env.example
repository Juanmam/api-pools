# Copy to .env and fill for local live tests (never commit real secrets).
#
# Opt-in live smoke: APIPOOLS_RUN_LIVE=1 and pytest -m live (see tests/test_social_live_smoke.py).

# --- YouTube Data API v3 (OAuth2 bearer; scopes: https://www.googleapis.com/auth/youtube.readonly)
APIPOOLS_RUN_LIVE=0
APIPOOLS_YOUTUBE_CHANNEL_ID=
APIPOOLS_YOUTUBE_ACCESS_TOKEN=

# --- Meta Graph (Instagram Business / Pages)
APIPOOLS_META_PAGE_ID=
APIPOOLS_META_INSTAGRAM_USER_ID=
APIPOOLS_META_USER_ACCESS_TOKEN=

# --- TikTok Login Kit / Open API (video.list scope; product approval varies)
APIPOOLS_TIKTOK_OPEN_ID=
APIPOOLS_TIKTOK_ACCESS_TOKEN=

# --- Optional: OAuth app credentials (exchange flows; see oauth helpers / docs)
APIPOOLS_META_APP_ID=
APIPOOLS_META_APP_SECRET=
APIPOOLS_GOOGLE_CLIENT_ID=
APIPOOLS_GOOGLE_CLIENT_SECRET=
APIPOOLS_GOOGLE_REFRESH_TOKEN=
APIPOOLS_TIKTOK_CLIENT_KEY=
APIPOOLS_TIKTOK_CLIENT_SECRET=
